-- TEST B2: Count UDI hits that do not exist in SEF

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
)

SELECT
    COUNT(1) AS udi_rows_not_in_sef
FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions AS udi
LEFT ANTI JOIN sef
    ON udi.row_identity_hash = sef.row_identity_hash
   AND udi.event_date = sef.event_date
   AND udi.source_table = sef.source_table
WHERE udi.event_date = DATE '2026-09-27';
output:
11677620

-- TEST C: Inspect older sessions with activity on September 27

SELECT
    ssf.session_id,
    ssf.session_start_date,
    ssf.session_start_time,
    ssf.session_end_time,
    COUNT(1) AS sef_hits_on_test_date
FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact AS sef
INNER JOIN prd_dbi_analytics.silver_digital_interactions.session_summary_fact AS ssf
    ON sef.session_id = ssf.session_id
WHERE sef.event_date = DATE '2026-09-27'
  AND ssf.session_start_date < DATE '2026-09-26'
GROUP BY
    ssf.session_id,
    ssf.session_start_date,
    ssf.session_start_time,
    ssf.session_end_time
ORDER BY
    ssf.session_start_date,
    ssf.session_start_time;
