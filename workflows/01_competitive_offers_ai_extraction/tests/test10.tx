-- ============================================================
-- TEST N:
-- Validate SEF visitor_key_value against UDI identity fields
-- ============================================================

SELECT
    sef.source_table,
    sef.visitor_key_type,

    COUNT(*) AS joined_hits,

    SUM(
        CASE
            WHEN sef.visitor_key_type = 'FPID'
             AND sef.visitor_key_value = udi.first_party_id
            THEN 1 ELSE 0
        END
    ) AS fpid_exact_matches,

    SUM(
        CASE
            WHEN sef.visitor_key_type = 'DEVICE_ID'
             AND sef.visitor_key_value = udi.attribute_device_id
            THEN 1 ELSE 0
        END
    ) AS device_id_exact_matches,

    SUM(
        CASE
            WHEN sef.visitor_key_type = 'DEVICE_ID'
             AND sef.visitor_key_value = udi.app_instance_id
            THEN 1 ELSE 0
        END
    ) AS app_instance_exact_matches,

    SUM(
        CASE
            WHEN sef.visitor_key_type = 'DEVICE_ID'
             AND sef.visitor_key_value = udi.app_session_id
            THEN 1 ELSE 0
        END
    ) AS app_session_exact_matches

FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact sef

JOIN prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi
    ON  sef.row_identity_hash = udi.row_identity_hash
    AND sef.event_date        = udi.event_date
    AND sef.source_table      = udi.source_table

WHERE sef.event_date = DATE '2026-09-27'

GROUP BY
    sef.source_table,
    sef.visitor_key_type

ORDER BY
    sef.source_table;
output:
source_table	visitor_key_type	joined_hits	fpid_exact_matches	device_id_exact_matches	app_instance_exact_matches	app_session_exact_matches
t_app_interactions	DEVICE_ID	212870423	0	212870423	125489009	0
t_web_interactions	FPID	28409587	28409587	0	0	0









-- ============================================================
-- TEST O:
-- Do unmatched APP events belong to devices that otherwise
-- have sessionized activity on the same day?
-- ============================================================

WITH sessionized_devices AS (
    SELECT DISTINCT
        visitor_key_value AS device_id
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
      AND source_table = 't_app_interactions'
      AND visitor_key_type = 'DEVICE_ID'
),

sef_keys AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

unmatched_app AS (
    SELECT
        udi.attribute_device_id,
        udi.page_app_type,
        udi.site_name,
        udi.attribute_event_type,
        udi.event_page_view,
        udi.event_purchase
    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi

    LEFT ANTI JOIN sef_keys sef
        ON  udi.row_identity_hash = sef.row_identity_hash
        AND udi.event_date        = sef.event_date
        AND udi.source_table      = sef.source_table

    WHERE udi.event_date = DATE '2026-09-27'
      AND udi.source_table = 't_app_interactions'
)

SELECT
    page_app_type,
    site_name,
    attribute_event_type,

    CASE
        WHEN sd.device_id IS NOT NULL
            THEN 'Device has other sessionized hits'
        ELSE 'Device never appears in SEF'
    END AS device_status,

    COUNT(*) AS unmatched_hits,

    COUNT(DISTINCT ua.attribute_device_id)
        AS distinct_devices,

    SUM(COALESCE(event_page_view, 0))
        AS pageviews,

    SUM(COALESCE(event_purchase, 0))
        AS purchases

FROM unmatched_app ua

LEFT JOIN sessionized_devices sd
    ON ua.attribute_device_id = sd.device_id

GROUP BY
    page_app_type,
    site_name,
    attribute_event_type,
    CASE
        WHEN sd.device_id IS NOT NULL
            THEN 'Device has other sessionized hits'
        ELSE 'Device never appears in SEF'
    END

ORDER BY unmatched_hits DESC;

