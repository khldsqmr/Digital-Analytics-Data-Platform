backend/app/routes/health.py
from fastapi import APIRouter, HTTPException

from app.db.databricks import fetch_one


router = APIRouter(
    prefix="/health",
    tags=["Health"],
)


@router.get("")
def health():
    return {
        "status": "ok"
    }


@router.get("/databricks")
def databricks_health():
    try:
        result = fetch_one(
            "SELECT 1 AS healthy"
        )

        return {
            "status": "ok",
            "databricks": result,
        }

    except Exception as exc:
        raise HTTPException(
            status_code=503,
            detail=f"Databricks unavailable: {exc}",
        ) from exc

backend/app/main.py
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app.config import settings
from app.routes import (
    breakouts,
    crosstabs,
    explore,
    health,
    metadata,
    overview,
)


app = FastAPI(
    title=settings.app_name,
    version="0.1.0",
    description=(
        "Backend API for the Media Intelligence Platform"
    ),
)


app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.cors_origin_list,
    allow_credentials=True,
    allow_methods=["GET"],
    allow_headers=["*"],
)


app.include_router(
    health.router,
    prefix=settings.api_prefix,
)

app.include_router(
    metadata.router,
    prefix=settings.api_prefix,
)

app.include_router(
    overview.router,
    prefix=settings.api_prefix,
)

app.include_router(
    breakouts.router,
    prefix=settings.api_prefix,
)

app.include_router(
    crosstabs.router,
    prefix=settings.api_prefix,
)

app.include_router(
    explore.router,
    prefix=settings.api_prefix,
)


@app.get("/")
def root():
    return {
        "application": settings.app_name,
        "status": "running",
        "api": settings.api_prefix,
        "swagger": "/docs",
    }

backend/tests/test_health.py
from fastapi.testclient import TestClient

from app.main import app


client = TestClient(app)


def test_health_endpoint():
    response = client.get(
        "/api/v1/health"
    )

    assert response.status_code == 200

    assert response.json() == {
        "status": "ok"
    }

backend/tests/test_schemas.py
import pytest
from pydantic import TypeAdapter, ValidationError

from app.schemas.common import (
    ComparisonType,
    DisplaySize,
)


def test_valid_comparison_type():
    adapter = TypeAdapter(ComparisonType)

    value = adapter.validate_python(
        "priorWeek"
    )

    assert value == ComparisonType.PRIOR_WEEK


def test_invalid_comparison_type():
    adapter = TypeAdapter(ComparisonType)

    with pytest.raises(ValidationError):
        adapter.validate_python(
            "randomComparison"
        )


def test_valid_display_size():
    adapter = TypeAdapter(DisplaySize)

    value = adapter.validate_python(
        "top10"
    )

    assert value == DisplaySize.TOP_10


def test_invalid_display_size():
    adapter = TypeAdapter(DisplaySize)

    with pytest.raises(ValidationError):
        adapter.validate_python(
            "top500"
        )

