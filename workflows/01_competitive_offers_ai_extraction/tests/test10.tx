-- ============================================================
-- TEST I:
-- Sessionization coverage by source / platform / site
-- ============================================================

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

base AS (
    SELECT
        udi.source_table,
        udi.page_app_type,
        udi.site_name,
        udi.attribute_event_type,
        udi.event_page_view,
        udi.event_purchase,

        CASE
            WHEN sef.row_identity_hash IS NOT NULL THEN 1
            ELSE 0
        END AS is_sessionized

    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi

    LEFT JOIN sef
        ON  udi.row_identity_hash = sef.row_identity_hash
        AND udi.event_date        = sef.event_date
        AND udi.source_table      = sef.source_table

    WHERE udi.event_date = DATE '2026-09-27'
)

SELECT
    source_table,
    page_app_type,
    site_name,
    attribute_event_type,

    COUNT(*) AS total_udi_hits,

    SUM(is_sessionized) AS sessionized_hits,

    COUNT(*) - SUM(is_sessionized) AS non_sessionized_hits,

    ROUND(
        100.0 * SUM(is_sessionized) / COUNT(*),
        2
    ) AS sessionized_pct,

    SUM(
        CASE
            WHEN is_sessionized = 0
            THEN COALESCE(event_page_view, 0)
            ELSE 0
        END
    ) AS non_sessionized_pageviews,

    SUM(
        CASE
            WHEN is_sessionized = 0
            THEN COALESCE(event_purchase, 0)
            ELSE 0
        END
    ) AS non_sessionized_purchases

FROM base

GROUP BY
    source_table,
    page_app_type,
    site_name,
    attribute_event_type

ORDER BY
    non_sessionized_hits DESC;
output:
