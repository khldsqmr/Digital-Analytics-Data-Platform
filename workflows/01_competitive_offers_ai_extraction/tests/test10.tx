-- ============================================================
-- TEST A: Are missing join-key values explaining the UDI-to-SEF gap?
-- Test date: 2026-09-27
-- ============================================================

SELECT
    'UDI' AS table_name,
    COUNT(*) AS total_rows,
    SUM(CASE WHEN row_identity_hash IS NULL THEN 1 ELSE 0 END)
        AS null_row_identity_hash,
    SUM(CASE WHEN source_table IS NULL THEN 1 ELSE 0 END)
        AS null_source_table,
    SUM(CASE WHEN event_date IS NULL THEN 1 ELSE 0 END)
        AS null_event_date
FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions
WHERE event_date = DATE '2026-09-27'

UNION ALL

SELECT
    'SEF' AS table_name,
    COUNT(*) AS total_rows,
    SUM(CASE WHEN row_identity_hash IS NULL THEN 1 ELSE 0 END)
        AS null_row_identity_hash,
    SUM(CASE WHEN source_table IS NULL THEN 1 ELSE 0 END)
        AS null_source_table,
    SUM(CASE WHEN event_date IS NULL THEN 1 ELSE 0 END)
        AS null_event_date
FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
WHERE event_date = DATE '2026-09-27';
output:
table_name	total_rows	null_row_identity_hash	null_source_table	null_event_date
UDI	252895361	0	0	0
SEF	241217741	0	0	0

-- ============================================================
-- TEST B: Profile UDI hits that do not exist in SEF
-- Test date: 2026-09-27
-- ============================================================

-- TEST B: Profile UDI hits that do not exist in SEF

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

unmatched AS (
    SELECT
        udi.source_table,
        udi.attribute_event_type,
        udi.site_name,
        udi.page_app_type,
        udi.event_page_view,
        udi.event_purchase
    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions AS udi
    LEFT ANTI JOIN sef
        ON udi.row_identity_hash = sef.row_identity_hash
       AND udi.event_date = sef.event_date
       AND udi.source_table = sef.source_table
    WHERE udi.event_date = DATE '2026-09-27'
)

SELECT
    source_table,
    attribute_event_type,
    page_app_type,
    site_name,
    COUNT(1) AS unmatched_hits,
    SUM(COALESCE(event_page_view, 0)) AS pageviews,
    SUM(COALESCE(event_purchase, 0)) AS purchases
FROM unmatched
GROUP BY
    source_table,
    attribute_event_type,
    page_app_type,
    site_name
ORDER BY unmatched_hits DESC
LIMIT 100;
