SELECT
    column_name,
    data_type,
    comment

FROM prd_dbi_analytics.information_schema.columns

WHERE table_schema = 'silver_digital_interactions'
  AND table_name = 'session_event_fact'

ORDER BY ordinal_position;
output:
column_name	data_type	comment
row_identity_hash	STRING	Deterministic event identity. Primary logical key used to join to unified_digital_interactions.
source_uuid	STRING	Original source UUID retained for lineage and troubleshooting.
source_table	STRING	Original interaction source: t_web_interactions or t_app_interactions.
event_date	DATE	UTC event date. Used with source_table and row_identity_hash when joining to the main Silver interaction table.
event_timestamp_utc	TIMESTAMP	Authoritative UTC event timestamp.
source_datalakeTimestamp	TIMESTAMP	Source ingestion timestamp retained for lineage and reconciliation.
session_id	STRING	Authoritative server-generated session identifier.
session_partition_key	STRING	Stable visitor-stream key used for server sessionization.
visitor_key_type	STRING	Visitor identifier used for sessionization: FPID for Web or DEVICE_ID for App.
visitor_key_value	STRING	FPID or DEVICE_ID value defining the visitor stream.
session_start_time	TIMESTAMP	Authoritative server-calculated start timestamp of the assigned session.
visit_number	LONG	Sequential authoritative visit/session number within the visitor stream.
hit_number_in_session	LONG	Authoritative chronological event position within the session.
adobe_visit_key	STRING	Derived Adobe-style visit key.
session_timeout_seconds	INT	Session inactivity timeout in seconds; current implementation uses 1800 seconds.
canonical_user_id	STRING	Current canonical user associated with the authoritative session.
identity_status	STRING	Current session identity result: RESOLVED, UNRESOLVED or CONFLICT.
resolution_identifier_type	STRING	Strongest identifier type used for current session identity resolution.
authority_rank	INT	Identity authority rank used to resolve the current session.
session_assignment_method	STRING	Assignment path such as CLIENT_VALIDATED_FAST_PATH, SERVER_FALLBACK or REPAIRED_SERVER_ASSIGNMENT.
assignment_version	LONG	Assignment version incremented when repair changes session membership.
first_pipeline_batch_id	STRING	Pipeline batch that first assigned the event.
last_pipeline_batch_id	STRING	Latest normal, repair or backfill run that changed the event assignment.
pipeline_batch_id	STRING	Pipeline, repair or backfill run that published the current row.
load_datetime_pst	TIMESTAMP	Pacific-time timestamp when the row was last published.
session_start_time_pst	TIMESTAMP	Session start timestamp converted from UTC to America/Los_Angeles local time.
event_timestamp_pst	TIMESTAMP	Event timestamp converted from UTC to America/Los_Angeles local time.
event_date_pst	DATE	Pacific local event date derived from event_timestamp_utc in America/Los_Angeles timezone.
flow_name	STRING	Name of the user journey flow from the assigned source event.
page_url_full	STRING	Event-level complete URL from the assigned source event.
page_url_path	STRING	Event-level URL path from the assigned source event.
page_referrer	STRING	Event-level referrer from the assigned source event.

SELECT
    column_name,
    data_type,
    comment

FROM prd_dbi_analytics.information_schema.columns

WHERE table_schema = 'silver_digital_interactions'
  AND table_name = 'session_event_fact'

  AND (
       LOWER(column_name) LIKE '%session%'
    OR LOWER(column_name) LIKE '%source%'
    OR LOWER(column_name) LIKE '%event%'
    OR LOWER(column_name) LIKE '%identity%'
    OR LOWER(column_name) LIKE '%user%'
    OR LOWER(column_name) LIKE '%visitor%'
    OR LOWER(column_name) LIKE '%id%'
  )

ORDER BY ordinal_position;

output:

column_name	data_type	comment
row_identity_hash	STRING	Deterministic event identity. Primary logical key used to join to unified_digital_interactions.
source_uuid	STRING	Original source UUID retained for lineage and troubleshooting.
source_table	STRING	Original interaction source: t_web_interactions or t_app_interactions.
event_date	DATE	UTC event date. Used with source_table and row_identity_hash when joining to the main Silver interaction table.
event_timestamp_utc	TIMESTAMP	Authoritative UTC event timestamp.
source_datalakeTimestamp	TIMESTAMP	Source ingestion timestamp retained for lineage and reconciliation.
session_id	STRING	Authoritative server-generated session identifier.
session_partition_key	STRING	Stable visitor-stream key used for server sessionization.
visitor_key_type	STRING	Visitor identifier used for sessionization: FPID for Web or DEVICE_ID for App.
visitor_key_value	STRING	FPID or DEVICE_ID value defining the visitor stream.
session_start_time	TIMESTAMP	Authoritative server-calculated start timestamp of the assigned session.
hit_number_in_session	LONG	Authoritative chronological event position within the session.
session_timeout_seconds	INT	Session inactivity timeout in seconds; current implementation uses 1800 seconds.
canonical_user_id	STRING	Current canonical user associated with the authoritative session.
identity_status	STRING	Current session identity result: RESOLVED, UNRESOLVED or CONFLICT.
resolution_identifier_type	STRING	Strongest identifier type used for current session identity resolution.
session_assignment_method	STRING	Assignment path such as CLIENT_VALIDATED_FAST_PATH, SERVER_FALLBACK or REPAIRED_SERVER_ASSIGNMENT.
first_pipeline_batch_id	STRING	Pipeline batch that first assigned the event.
last_pipeline_batch_id	STRING	Latest normal, repair or backfill run that changed the event assignment.
pipeline_batch_id	STRING	Pipeline, repair or backfill run that published the current row.
session_start_time_pst	TIMESTAMP	Session start timestamp converted from UTC to America/Los_Angeles local time.
event_timestamp_pst	TIMESTAMP	Event timestamp converted from UTC to America/Los_Angeles local time.
event_date_pst	DATE	Pacific local event date derived from event_timestamp_utc in America/Los_Angeles timezone.






-- ============================================================
-- TEST K:
-- What visitor key is EDL actually using for each source?
-- ============================================================

SELECT
    source_table,
    visitor_key_type,

    COUNT(*) AS hit_count,
    COUNT(DISTINCT visitor_key_value) AS distinct_visitor_keys,
    COUNT(DISTINCT session_id) AS distinct_sessions,

    SUM(
        CASE
            WHEN visitor_key_value IS NULL THEN 1
            ELSE 0
        END
    ) AS null_visitor_key_rows

FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact

WHERE event_date = DATE '2026-09-27'

GROUP BY
    source_table,
    visitor_key_type

ORDER BY
    source_table,
    hit_count DESC;
output:
source_table	visitor_key_type	hit_count	distinct_visitor_keys	distinct_sessions	null_visitor_key_rows
t_app_interactions	DEVICE_ID	212870423	3002348	3871833	0
t_web_interactions	FPID	28409587	1812504	2048845	0

-- ============================================================
-- TEST L:
-- Find potential visitor/session key columns in UDI
-- ============================================================

SELECT
    column_name,
    data_type,
    comment

FROM prd_dbi_analytics.information_schema.columns

WHERE table_schema = 'silver_digital_interactions'
  AND table_name = 'unified_digital_interactions'

  AND (
       LOWER(column_name) LIKE '%device%'
    OR LOWER(column_name) LIKE '%visitor%'
    OR LOWER(column_name) LIKE '%first_party%'
    OR LOWER(column_name) LIKE '%fpid%'
    OR LOWER(column_name) LIKE '%session%'
    OR LOWER(column_name) LIKE '%instance%'
  )

ORDER BY ordinal_position;
output:
column_name	data_type	comment
first_party_id	STRING	T-Mobile-assigned first-party browser cookie (FPID) designed to bypass Safari's 7-day ITP cookie expiration. Primary persistent visitor identifier for web, enabling longer-term return visit recognition.
app_device_model	STRING	Make and model of the device used when visiting the TLife app (e.g., iPhone 15 Pro, Samsung Galaxy S24). Enables device-level segmentation for app experience analysis and compatibility testing.
app_instance_id	STRING	App instance identifier created upon app installation, used by MoEngage as a primary device identifier. Merged with the user's profile UID upon login. Regenerated if the app is uninstalled and reinstalled.
app_session_id	STRING	Session identifier generated by Secure ID or Apigee for the native app session.
device_info	STRING	Device details being viewed on the current web or app screen, such as device name, model, and specifications. Captured during device browsing for product interest analysis.
device_status	STRING	Device lock and unlock status, including unlock type (Temporary, Permanent, Locked, NA). Used to understand device eligibility and service status on customer accounts.
event_device_network_check	INT	Fires when a device network compatibility check is performed. Measures the volume of device-network verification requests, typically used during BYOD or device upgrade flows.
cart_device_type	STRING	Primary device category in the user's cart during checkout: BYOD, Home Internet, Cell Phone, or IoT. Segments the shopping journey by product intent.
attribute_device_device_brand	STRING	Device brand from the OneMind device block. Typically the consumer-facing brand name of the device (e.g., Samsung Galaxy, Google Pixel).
attribute_device_device_category	STRING	Device classification from OneMind device block: iPhone, Android phone, tablet, or large-screen phone. Used for form-factor segmentation in app analytics.
attribute_device_device_manufacturer	STRING	Device manufacturer from the OneMind device telemetry block. Captures the company that produced the device (e.g., Samsung, Apple, Motorola).
attribute_device_id	STRING	OneMind device identifier generated based on app install and uninstall lifecycle. Regenerated upon reinstallation. Serves as the primary device-level identity key in the OneMind telemetry system.
attribute_device_resolution	STRING	Screen resolution of the user's device as reported by OneMind (e.g., 1170x2532). Enables resolution-based analysis of UI rendering and layout optimization.
attribute_network_device_carrier	STRING	Name of the mobile network carrier from OneMind. Currently unused and unpopulated, reserved for future implementation to capture the detected carrier of the user's device.
attribute_session_visit_type	STRING	OneMind visit type indicating whether the user is a Returning or New visitor within the app session. Provides app-native new vs. returning classification independent of Adobe visit logic.
attribute_device_count	INT	Total number of devices shown in the Me screen card on the Tlife App
device_ip_address	STRING	IP address of the device making the request.







-- ============================================================
-- TEST M:
-- Do non-sessionized UDI rows lack the key EDL uses
-- for sessionization?
-- ============================================================

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

base AS (
    SELECT
        udi.source_table,
        udi.page_app_type,
        udi.site_name,

        udi.first_party_id,
        udi.attribute_device_id,

        udi.event_page_view,
        udi.event_purchase,

        CASE
            WHEN sef.row_identity_hash IS NOT NULL THEN 1
            ELSE 0
        END AS is_sessionized

    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi

    LEFT JOIN sef
        ON  udi.row_identity_hash = sef.row_identity_hash
        AND udi.event_date        = sef.event_date
        AND udi.source_table      = sef.source_table

    WHERE udi.event_date = DATE '2026-09-27'
)

SELECT
    source_table,
    page_app_type,
    site_name,
    is_sessionized,

    COUNT(*) AS hits,

    SUM(CASE
        WHEN first_party_id IS NOT NULL THEN 1
        ELSE 0
    END) AS has_fpid,

    SUM(CASE
        WHEN attribute_device_id IS NOT NULL THEN 1
        ELSE 0
    END) AS has_device_id,

    SUM(COALESCE(event_page_view, 0)) AS pageviews,
    SUM(COALESCE(event_purchase, 0)) AS purchases

FROM base

GROUP BY
    source_table,
    page_app_type,
    site_name,
    is_sessionized

ORDER BY
    source_table,
    page_app_type,
    site_name,
    is_sessionized DESC;
