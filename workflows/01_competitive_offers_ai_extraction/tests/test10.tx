-- TEST D2: Count SSF sessions with no September 27 SEF record

WITH sef_sessions AS (
    SELECT DISTINCT
        session_id
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
)

SELECT
    COUNT(1) AS ssf_sessions_not_in_sef
FROM prd_dbi_analytics.silver_digital_interactions.session_summary_fact AS ssf
LEFT ANTI JOIN sef_sessions
    ON ssf.session_id = sef_sessions.session_id
WHERE ssf.session_start_date = DATE '2026-09-27';
output:
406

-- TEST E: Final three-table join cardinality check

WITH udi AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions
    WHERE event_date = DATE '2026-09-27'
),

sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table,
        session_id
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
)

SELECT
    COUNT(1) AS final_join_rows,
    COUNT(DISTINCT udi.row_identity_hash) AS distinct_hit_ids,
    COUNT(DISTINCT sef.session_id) AS distinct_sef_sessions,
    COUNT(DISTINCT ssf.session_id) AS distinct_summary_sessions
FROM udi
INNER JOIN sef
    ON udi.row_identity_hash = sef.row_identity_hash
   AND udi.event_date = sef.event_date
   AND udi.source_table = sef.source_table
INNER JOIN prd_dbi_analytics.silver_digital_interactions.session_summary_fact AS ssf
    ON sef.session_id = ssf.session_id;
output:
final_join_rows	distinct_hit_ids	distinct_sef_sessions	distinct_summary_sessions
241217741	241217741	5919984	5919984

-- TEST F: Check duplicate join-key combinations

WITH key_counts AS (
    SELECT
        'UDI' AS table_name,
        row_identity_hash,
        event_date,
        source_table,
        COUNT(1) AS records_per_key
    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions
    WHERE event_date = DATE '2026-09-27'
    GROUP BY
        row_identity_hash,
        event_date,
        source_table
    HAVING COUNT(1) > 1

    UNION ALL

    SELECT
        'SEF' AS table_name,
        row_identity_hash,
        event_date,
        source_table,
        COUNT(1) AS records_per_key
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
    GROUP BY
        row_identity_hash,
        event_date,
        source_table
    HAVING COUNT(1) > 1
)

SELECT
    table_name,
    COUNT(1) AS duplicated_key_combinations,
    SUM(records_per_key) AS rows_on_duplicated_keys,
    MAX(records_per_key) AS maximum_records_per_key
FROM key_counts
GROUP BY table_name
ORDER BY table_name;
output:
No rows returned











-- ============================================================
-- TEST G:
-- For UDI rows that fail the full UDI → SEF join,
-- does the same row_identity_hash exist in SEF anyway?
-- ============================================================

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

unmatched AS (
    SELECT
        udi.row_identity_hash,
        udi.event_date,
        udi.source_table,
        udi.page_app_type,
        udi.site_name,
        udi.event_page_view,
        udi.event_purchase
    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi

    LEFT ANTI JOIN sef
        ON  udi.row_identity_hash = sef.row_identity_hash
        AND udi.event_date        = sef.event_date
        AND udi.source_table      = sef.source_table

    WHERE udi.event_date = DATE '2026-09-27'
),

sef_hash AS (
    SELECT DISTINCT
        row_identity_hash
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
)

SELECT
    CASE
        WHEN s.row_identity_hash IS NOT NULL
            THEN 'Hash exists in SEF - other join field differs'
        ELSE 'Hash completely absent from SEF'
    END AS match_status,

    COUNT(*) AS hits,
    SUM(COALESCE(u.event_page_view, 0)) AS pageviews,
    SUM(COALESCE(u.event_purchase, 0)) AS purchases

FROM unmatched u

LEFT JOIN sef_hash s
    ON u.row_identity_hash = s.row_identity_hash

GROUP BY 1
ORDER BY hits DESC;
output:
match_status	hits	pageviews	purchases
Hash completely absent from SEF	11677620	4942210	962

-- ============================================================
-- TEST H:
-- Identity/session-field availability on unmatched UDI hits
-- ============================================================

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

unmatched AS (
    SELECT udi.*
    FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi

    LEFT ANTI JOIN sef
        ON  udi.row_identity_hash = sef.row_identity_hash
        AND udi.event_date        = sef.event_date
        AND udi.source_table      = sef.source_table

    WHERE udi.event_date = DATE '2026-09-27'
)

SELECT
    source_table,
    page_app_type,
    site_name,

    COUNT(*) AS unmatched_hits,

    SUM(CASE WHEN customer_id IS NOT NULL THEN 1 ELSE 0 END)
        AS has_customer_id,

    SUM(CASE WHEN first_party_id IS NOT NULL THEN 1 ELSE 0 END)
        AS has_first_party_id,

    SUM(CASE WHEN app_instance_id IS NOT NULL THEN 1 ELSE 0 END)
        AS has_app_instance_id,

    SUM(CASE WHEN app_session_id IS NOT NULL THEN 1 ELSE 0 END)
        AS has_app_session_id,

    SUM(CASE WHEN profile_uid IS NOT NULL THEN 1 ELSE 0 END)
        AS has_profile_uid,

    SUM(COALESCE(event_page_view, 0))
        AS pageviews,

    SUM(COALESCE(event_purchase, 0))
        AS purchases

FROM unmatched

GROUP BY
    source_table,
    page_app_type,
    site_name

ORDER BY unmatched_hits DESC;
