SELECT
    session_start_date,
    COUNT(*) AS sessions,

    COUNT_IF(entry_page_url_path IS NULL OR trim(entry_page_url_path)='') AS missingEntryPath,
    ROUND(
        100.0*COUNT_IF(entry_page_url_path IS NULL OR trim(entry_page_url_path)='')/COUNT(*),
        2
    ) AS missingEntryPathPct,

    COUNT_IF(entry_page_url_full IS NULL OR trim(entry_page_url_full)='') AS missingEntryFull,
    ROUND(
        100.0*COUNT_IF(entry_page_url_full IS NULL OR trim(entry_page_url_full)='')/COUNT(*),
        2
    ) AS missingEntryFullPct,

    COUNT_IF(lower(entry_page_url_full) LIKE '%utm_source=%') AS hasUtmSource,
    COUNT_IF(lower(entry_page_url_full) LIKE '%utm_medium=%') AS hasUtmMedium,
    COUNT_IF(lower(entry_page_url_full) LIKE '%utm_campaign=%') AS hasUtmCampaign

FROM prdrzranalytics.lab42.sdi_tbl_mip_bronze_edlSessions_daily
GROUP BY session_start_date
ORDER BY session_start_date DESC;

