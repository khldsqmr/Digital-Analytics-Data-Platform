-- TEST D: SSF sessions for September 27 with no September 27 SEF record

WITH sef_sessions AS (
    SELECT DISTINCT
        session_id
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
),

missing AS (
    SELECT
        ssf.session_id,
        ssf.session_start_date,
        ssf.session_start_time,
        ssf.session_end_time,
        ssf.canonical_user_id,
        ssf.entry_page_url_path
    FROM prd_dbi_analytics.silver_digital_interactions.session_summary_fact AS ssf
    LEFT ANTI JOIN sef_sessions
        ON ssf.session_id = sef_sessions.session_id
    WHERE ssf.session_start_date = DATE '2026-09-27'
)

SELECT
    session_id,
    session_start_date,
    session_start_time,
    session_end_time,
    canonical_user_id,
    entry_page_url_path
FROM missing
ORDER BY session_start_time
LIMIT 500;
