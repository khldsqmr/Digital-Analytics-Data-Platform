    COUNT_IF(utmMedium IS NULL OR trim(utmMedium)='') AS missingUtmMedium,
    ROUND(100.0*COUNT_IF(utmMedium IS NULL OR trim(utmMedium)='')/COUNT(*),2) AS missingUtmMediumPct,
    COUNT_IF(utmCampaign IS NULL OR trim(utmCampaign)='') AS missingUtmCampaign,
    ROUND(100.0*COUNT_IF(utmCampaign IS NULL OR trim(utmCampaign)='')/COUNT(*),2) AS missingUtmCampaignPct,
