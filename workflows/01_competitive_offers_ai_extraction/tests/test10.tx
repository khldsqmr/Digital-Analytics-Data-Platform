from contextlib import contextmanager
from typing import Any, Iterable, Iterator

from databricks import sql

from app.config import settings


def _validate_connection_settings() -> None:
    missing = []

    if not settings.databricks_server_hostname:
        missing.append("MIP_DATABRICKS_SERVER_HOSTNAME")

    if not settings.databricks_http_path:
        missing.append("MIP_DATABRICKS_HTTP_PATH")

    if not settings.databricks_access_token:
        missing.append("MIP_DATABRICKS_ACCESS_TOKEN")

    if missing:
        raise RuntimeError(
            "Missing Databricks configuration: "
            + ", ".join(missing)
        )


@contextmanager
def get_connection() -> Iterator[Any]:
    """
    Creates a Databricks SQL Warehouse connection.

    For now this uses a token.
    Authentication can later be replaced with service-principal/OAuth
    without changing the API routes or services.
    """
    _validate_connection_settings()

    connection = sql.connect(
        server_hostname=settings.databricks_server_hostname,
        http_path=settings.databricks_http_path,
        access_token=settings.databricks_access_token,
    )

    try:
        yield connection
    finally:
        connection.close()


def fetch_all(
    statement: str,
    parameters: Iterable[Any] | None = None,
) -> list[dict[str, Any]]:
    """
    Executes a parameterized SELECT and returns dictionaries.

    Example output:
    [
        {
            "metricName": "orders",
            "currentValue": 12500
        }
    ]
    """

    with get_connection() as connection:
        with connection.cursor() as cursor:
            cursor.execute(
                statement,
                list(parameters or []),
            )

            if cursor.description is None:
                return []

            columns = [
                column[0]
                for column in cursor.description
            ]

            rows = cursor.fetchall()

            return [
                {
                    columns[index]: value
                    for index, value in enumerate(row)
                }
                for row in rows
            ]


def fetch_one(
    statement: str,
    parameters: Iterable[Any] | None = None,
) -> dict[str, Any] | None:

    rows = fetch_all(
        statement,
        parameters,
    )

    return rows[0] if rows else None




from enum import Enum
from typing import Any

from pydantic import BaseModel


class ComparisonType(str, Enum):
    PRIOR_WEEK = "priorWeek"
    FOUR_WEEK = "fourWeek"
    LAST_YEAR = "lastYear"


class DisplaySize(str, Enum):
    TOP_5 = "top5"
    TOP_10 = "top10"
    ALL = "all"


class SectionResponse(BaseModel):
    """
    Common response structure used by all 11 sections.
    """

    section: str
    filters: dict[str, Any]
    rowCount: int
    data: list[dict[str, Any]]


-- CONFIG.PY
from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_prefix="MIP_",
        case_sensitive=False,
        extra="ignore",
    )

    app_name: str = "Media Intelligence Platform API"
    api_prefix: str = "/api/v1"

    # Local frontend for now
    cors_origins: str = "http://localhost:5173"

    # Databricks SQL Warehouse
    databricks_server_hostname: str = ""
    databricks_http_path: str = ""
    databricks_access_token: str = ""

    # Unity Catalog location
    databricks_catalog: str = "prdrzranalytics"
    databricks_schema: str = "lab42"

    @property
    def cors_origin_list(self) -> list[str]:
        return [
            value.strip()
            for value in self.cors_origins.split(",")
            if value.strip()
        ]

    def table(self, table_name: str) -> str:
        """
        Returns a fully qualified Databricks table name.

        Example:
        prdrzranalytics.lab42.sdi_tbl_mip_gold_appOverviewCards_wide
        """
        return (
            f"{self.databricks_catalog}."
            f"{self.databricks_schema}."
            f"{table_name}"
        )


@lru_cache
def get_settings() -> Settings:
    return Settings()


settings = get_settings()


EXPLORE.PY
Explore is the one section where schema validation matters a lot because the user can choose dimensions dynamically.

from enum import Enum


class ExploreDimension(str, Enum):
    PAGE_CATEGORY = "pageCategory"
    CHANNEL = "channel"
    CAMPAIGN = "campaign"
    DEVICE = "device"
    PROSPECT_VS_BASE = "prospectVsBase"
    AUTH_STATE = "authState"
    ENTRY_PAGE = "entryPage"
    BUY_FLOW_STEP = "buyFlowStep"
    REGION = "region"
    UTM_SOURCE = "utmSource"
    UTM_MEDIUM = "utmMedium"
    UTM_CAMPAIGN = "utmCampaign"


class ExploreMetric(str, Enum):
    SESSIONS = "sessions"
    PAGE_VIEWS = "pageViews"
    ORDERS = "orders"
    VR_CALLS = "vrCalls"
    VR_CHATS = "vrChats"
    STORE_LOCATOR = "storeLocator"
    ASSISTED_ORDERS = "assistedOrders"
    CONFIGURE_EVENTS = "configureEvents"
    CHECKOUT_START_EVENTS = "checkoutStartEvents"



services/overview.py:
from datetime import date

from app.config import settings
from app.db.databricks import fetch_all


OVERVIEW_CARDS_TABLE = (
    "sdi_tbl_mip_gold_appOverviewCards_wide"
)

OVERVIEW_TREND_TABLE = (
    "sdi_tbl_mip_gold_appOverviewTrend_long"
)

OVERVIEW_MOVERS_TABLE = (
    "sdi_tbl_mip_gold_appOverviewToplineMovers_long"
)

OVERVIEW_FUNNEL_TABLE = (
    "sdi_tbl_mip_gold_appOverviewConversionFunnel_long"
)


def get_cards(
    week: date,
    lob: str,
    platform: str,
):
    """
    Cards show all comparisons simultaneously,
    so comparisonType/displaySize are intentionally not used.
    """

    query = f"""
        SELECT *
        FROM {settings.table(OVERVIEW_CARDS_TABLE)}
        WHERE targetWeekStartDate = ?
          AND filterLob = ?
          AND filterPlatform = ?
        ORDER BY sortOrder, metricName
    """

    return fetch_all(
        query,
        [week, lob, platform],
    )


def get_trend(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    metric: str | None,
):
    conditions = [
        "targetWeekStartDate = ?",
        "filterLob = ?",
        "filterPlatform = ?",
        "comparisonType = ?",
    ]

    parameters = [
        week,
        lob,
        platform,
        comparison_type,
    ]

    if metric:
        conditions.append("metricName = ?")
        parameters.append(metric)

    query = f"""
        SELECT *
        FROM {settings.table(OVERVIEW_TREND_TABLE)}
        WHERE {" AND ".join(conditions)}
        ORDER BY
            metricSortOrder,
            comparisonSortOrder,
            metricName
    """

    return fetch_all(
        query,
        parameters,
    )


def get_topline_movers(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
):
    """
    Topline Movers does not physically have displaySize.
    It already contains global impact ranks.

    We translate the global Top5/Top10/All selector
    into a rank limit here.
    """

    display_limit = {
        "top5": 5,
        "top10": 10,
        "all": 100,
    }[display_size]

    conditions = [
        "targetWeekStartDate = ?",
        "filterLob = ?",
        "filterPlatform = ?",
        "comparisonType = ?",
        "impactRankAcrossBreakouts <= ?",
    ]

    parameters = [
        week,
        lob,
        platform,
        comparison_type,
        display_limit,
    ]

    if metric:
        conditions.append("metricName = ?")
        parameters.append(metric)

    query = f"""
        SELECT *
        FROM {settings.table(OVERVIEW_MOVERS_TABLE)}
        WHERE {" AND ".join(conditions)}
        ORDER BY impactRankAcrossBreakouts
    """

    return fetch_all(
        query,
        parameters,
    )


def get_conversion_funnel(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
):
    query = f"""
        SELECT *
        FROM {settings.table(OVERVIEW_FUNNEL_TABLE)}
        WHERE targetWeekStartDate = ?
          AND filterLob = ?
          AND filterPlatform = ?
          AND comparisonType = ?
        ORDER BY funnelStepOrder
    """

    return fetch_all(
        query,
        [
            week,
            lob,
            platform,
            comparison_type,
        ],
    )

backend/app/services/breakouts.py
from datetime import date

from app.config import settings
from app.db.databricks import fetch_all


COMPARISON_TABLE = (
    "sdi_tbl_mip_gold_appBreakoutsComparisonTable_long"
)

WATERFALL_TABLE = (
    "sdi_tbl_mip_gold_appBreakoutsWaterfall_long"
)

ABSOLUTE_TREND_TABLE = (
    "sdi_tbl_mip_gold_appBreakoutsAbsoluteTrend_long"
)


def _query_breakout_table(
    table_name: str,
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    breakout_type: str | None,
):
    conditions = [
        "targetWeekStartDate = ?",
        "filterLob = ?",
        "filterPlatform = ?",
        "comparisonType = ?",
        "displaySize = ?",
    ]

    parameters = [
        week,
        lob,
        platform,
        comparison_type,
        display_size,
    ]

    if metric:
        conditions.append("metricName = ?")
        parameters.append(metric)

    if breakout_type:
        conditions.append("breakoutType = ?")
        parameters.append(breakout_type)

    query = f"""
        SELECT *
        FROM {settings.table(table_name)}
        WHERE {" AND ".join(conditions)}
        ORDER BY
            metricSortOrder,
            breakoutSortOrder,
            displayRank,
            breakoutValue
    """

    return fetch_all(
        query,
        parameters,
    )


def get_comparison(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    breakout_type: str | None,
):
    return _query_breakout_table(
        COMPARISON_TABLE,
        week,
        lob,
        platform,
        comparison_type,
        display_size,
        metric,
        breakout_type,
    )


def get_waterfall(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    breakout_type: str | None,
):
    return _query_breakout_table(
        WATERFALL_TABLE,
        week,
        lob,
        platform,
        comparison_type,
        display_size,
        metric,
        breakout_type,
    )


def get_absolute_trend(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    breakout_type: str | None,
):
    return _query_breakout_table(
        ABSOLUTE_TREND_TABLE,
        week,
        lob,
        platform,
        comparison_type,
        display_size,
        metric,
        breakout_type,
    )

backend/app/services/crosstabs.py
from datetime import date

from app.config import settings
from app.db.databricks import fetch_all


MATRIX_TABLE = (
    "sdi_tbl_mip_gold_appCrosstabsMatrix_long"
)

RANKED_PAIRS_TABLE = (
    "sdi_tbl_mip_gold_appCrosstabsRankedPairs_long"
)


def get_matrix(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    pair_key: str | None,
):
    conditions = [
        "targetWeekStartDate = ?",
        "filterLob = ?",
        "filterPlatform = ?",
        "comparisonType = ?",
        "displaySize = ?",
    ]

    parameters = [
        week,
        lob,
        platform,
        comparison_type,
        display_size,
    ]

    if metric:
        conditions.append("metricName = ?")
        parameters.append(metric)

    if pair_key:
        conditions.append("pairKey = ?")
        parameters.append(pair_key)

    query = f"""
        SELECT *
        FROM {settings.table(MATRIX_TABLE)}
        WHERE {" AND ".join(conditions)}
        ORDER BY
            pairSortOrder,
            metricSortOrder,
            rowDisplayRank,
            columnDisplayRank
    """

    return fetch_all(
        query,
        parameters,
    )


def get_ranked_pairs(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    pair_key: str | None,
):
    """
    RankedPairs does not physically use displaySize.

    We apply the global display selector using its
    cross-pair impact rank.
    """

    display_limit = {
        "top5": 5,
        "top10": 10,
        "all": 100,
    }[display_size]

    conditions = [
        "targetWeekStartDate = ?",
        "filterLob = ?",
        "filterPlatform = ?",
        "comparisonType = ?",
        "cellImpactRankAcrossPairs <= ?",
    ]

    parameters = [
        week,
        lob,
        platform,
        comparison_type,
        display_limit,
    ]

    if metric:
        conditions.append("metricName = ?")
        parameters.append(metric)

    if pair_key:
        conditions.append("pairKey = ?")
        parameters.append(pair_key)

    query = f"""
        SELECT *
        FROM {settings.table(RANKED_PAIRS_TABLE)}
        WHERE {" AND ".join(conditions)}
        ORDER BY
            cellImpactRankAcrossPairs,
            pairSortOrder
    """

    return fetch_all(
        query,
        parameters,
    )

backend/app/services/explore.py
from datetime import date

from app.config import settings
from app.db.databricks import fetch_all


EXPLORE_BASE_TABLE = (
    "sdi_tbl_mip_gold_appExploreBase_wide"
)

EXPLORE_RANKED_PAIRS_TABLE = (
    "sdi_tbl_mip_gold_appExploreRankedPairs_long"
)


DIMENSIONS = {
    "pageCategory": "pageCategory",
    "channel": "channel",
    "campaign": "campaign",
    "device": "device",
    "prospectVsBase": "prospectVsBase",
    "authState": "authState",
    "entryPage": "entryPage",
    "buyFlowStep": "buyFlowStep",
    "region": "region",
    "utmSource": "utmSource",
    "utmMedium": "utmMedium",
    "utmCampaign": "utmCampaign",
}


METRICS = {
    "sessions": "count(DISTINCT sessionId)",
    "pageViews": "sum(pageViews)",
    "orders": "sum(orderCount)",
    "vrCalls": "sum(vrCallEvents)",
    "vrChats": "sum(vrChatEvents)",
    "storeLocator": "sum(storeLocatorEvents)",
    "assistedOrders": "sum(assistedOrderEvents)",
    "configureEvents": "sum(configureEvents)",
    "checkoutStartEvents": "sum(checkoutStartEvents)",
}


def get_results(
    week: date,
    lob: str,
    platform: str,
    dimension: str,
    metric: str,
    channel: str | None,
    device: str | None,
    page_category: str | None,
):
    """
    Dynamically aggregates Explore inside Databricks.

    Only DIMENSIONS and METRICS from the whitelist above
    can be inserted into the SQL statement.
    """

    dimension_sql = DIMENSIONS[dimension]
    metric_sql = METRICS[metric]

    conditions = [
        "weekStartDate = ?",
    ]

    parameters = [
        week,
    ]

    if lob != "All":
        conditions.append(
            "array_contains(lobList, ?)"
        )
        parameters.append(lob)

    if platform != "All":
        conditions.append(
            "platform = ?"
        )
        parameters.append(platform)

    if channel:
        conditions.append(
            "channel = ?"
        )
        parameters.append(channel)

    if device:
        conditions.append(
            "device = ?"
        )
        parameters.append(device)

    if page_category:
        conditions.append(
            "pageCategory = ?"
        )
        parameters.append(page_category)

    query = f"""
        SELECT
            coalesce(
                cast({dimension_sql} AS STRING),
                '(not set)'
            ) AS dimensionValue,

            {metric_sql} AS metricValue

        FROM {settings.table(EXPLORE_BASE_TABLE)}

        WHERE {" AND ".join(conditions)}

        GROUP BY
            coalesce(
                cast({dimension_sql} AS STRING),
                '(not set)'
            )

        ORDER BY
            metricValue DESC NULLS LAST,
            dimensionValue

        LIMIT 100
    """

    return fetch_all(
        query,
        parameters,
    )


def get_ranked_pairs(
    week: date,
    lob: str,
    platform: str,
    comparison_type: str,
    display_size: str,
    metric: str | None,
    pair_key: str | None,
):
    display_limit = {
        "top5": 5,
        "top10": 10,
        "all": 100,
    }[display_size]

    conditions = [
        "weekStartDate = ?",
        "filterLob = ?",
        "filterPlatform = ?",
        "comparisonType = ?",
        "cellImpactRankAcrossPairs <= ?",
    ]

    parameters = [
        week,
        lob,
        platform,
        comparison_type,
        display_limit,
    ]

    if metric:
        conditions.append("metricName = ?")
        parameters.append(metric)

    if pair_key:
        conditions.append("pairKey = ?")
        parameters.append(pair_key)

    query = f"""
        SELECT *
        FROM {settings.table(EXPLORE_RANKED_PAIRS_TABLE)}
        WHERE {" AND ".join(conditions)}
        ORDER BY
            cellImpactRankAcrossPairs,
            pairSortOrder
    """

    return fetch_all(
        query,
        parameters,
    )

backend/app/services/metadata.py
from app.config import settings
from app.db.databricks import fetch_all


CARDS_TABLE = (
    "sdi_tbl_mip_gold_appOverviewCards_wide"
)

BREAKOUTS_TABLE = (
    "sdi_tbl_mip_gold_appBreakoutsComparisonTable_long"
)

CROSSTABS_TABLE = (
    "sdi_tbl_mip_gold_appCrosstabsMatrix_long"
)


def get_metadata():
    weeks = fetch_all(
        f"""
        SELECT DISTINCT
            targetWeekStartDate AS value
        FROM {settings.table(CARDS_TABLE)}
        WHERE targetWeekStartDate IS NOT NULL
        ORDER BY value DESC
        """
    )

    lobs = fetch_all(
        f"""
        SELECT DISTINCT
            filterLob AS value
        FROM {settings.table(CARDS_TABLE)}
        WHERE filterLob IS NOT NULL
        ORDER BY value
        """
    )

    platforms = fetch_all(
        f"""
        SELECT DISTINCT
            filterPlatform AS value
        FROM {settings.table(CARDS_TABLE)}
        WHERE filterPlatform IS NOT NULL
        ORDER BY value
        """
    )

    metrics = fetch_all(
        f"""
        SELECT DISTINCT
            metricName,
            metricLabel
        FROM {settings.table(CARDS_TABLE)}
        WHERE metricName IS NOT NULL
        ORDER BY metricLabel
        """
    )

    breakout_types = fetch_all(
        f"""
        SELECT DISTINCT
            breakoutType AS value
        FROM {settings.table(BREAKOUTS_TABLE)}
        WHERE breakoutType IS NOT NULL
        ORDER BY value
        """
    )

    pair_keys = fetch_all(
        f"""
        SELECT DISTINCT
            pairKey AS value
        FROM {settings.table(CROSSTABS_TABLE)}
        WHERE pairKey IS NOT NULL
        ORDER BY value
        """
    )

    return {
        "weeks": [
            row["value"]
            for row in weeks
        ],

        "lobs": [
            row["value"]
            for row in lobs
        ],

        "platforms": [
            row["value"]
            for row in platforms
        ],

        "comparisonTypes": [
            "priorWeek",
            "fourWeek",
            "lastYear",
        ],

        "displaySizes": [
            "top5",
            "top10",
            "all",
        ],

        "metrics": metrics,

        "breakoutTypes": [
            row["value"]
            for row in breakout_types
        ],

        "pairKeys": [
            row["value"]
            for row in pair_keys
        ],
    }

backend/app/routes/overview.py
from datetime import date

from fastapi import APIRouter, Query

from app.schemas.common import (
    ComparisonType,
    DisplaySize,
    SectionResponse,
)
from app.services import overview as service


router = APIRouter(
    prefix="/overview",
    tags=["Overview"],
)


def build_response(
    section: str,
    filters: dict,
    data: list[dict],
) -> SectionResponse:

    return SectionResponse(
        section=section,
        filters=filters,
        rowCount=len(data),
        data=data,
    )


@router.get(
    "/cards",
    response_model=SectionResponse,
)
def cards(
    week: date,
    lob: str = "All",
    platform: str = "All",
):
    data = service.get_cards(
        week=week,
        lob=lob,
        platform=platform,
    )

    return build_response(
        "overviewCards",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
        },
        data,
    )


@router.get(
    "/trend",
    response_model=SectionResponse,
)
def trend(
    week: date,
    lob: str = "All",
    platform: str = "All",

    comparison_type: ComparisonType = Query(
        default=ComparisonType.PRIOR_WEEK,
        alias="comparisonType",
    ),

    metric: str | None = None,
):
    data = service.get_trend(
        week=week,
        lob=lob,
        platform=platform,
        comparison_type=comparison_type.value,
        metric=metric,
    )

    return build_response(
        "overviewTrend",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "comparisonType": comparison_type,
            "metric": metric,
        },
        data,
    )


@router.get(
    "/topline-movers",
    response_model=SectionResponse,
)
def topline_movers(
    week: date,
    lob: str = "All",
    platform: str = "All",

    comparison_type: ComparisonType = Query(
        default=ComparisonType.PRIOR_WEEK,
        alias="comparisonType",
    ),

    display_size: DisplaySize = Query(
        default=DisplaySize.TOP_10,
        alias="displaySize",
    ),

    metric: str | None = None,
):
    data = service.get_topline_movers(
        week=week,
        lob=lob,
        platform=platform,
        comparison_type=comparison_type.value,
        display_size=display_size.value,
        metric=metric,
    )

    return build_response(
        "overviewToplineMovers",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "comparisonType": comparison_type,
            "displaySize": display_size,
            "metric": metric,
        },
        data,
    )


@router.get(
    "/conversion-funnel",
    response_model=SectionResponse,
)
def conversion_funnel(
    week: date,
    lob: str = "All",
    platform: str = "All",

    comparison_type: ComparisonType = Query(
        default=ComparisonType.PRIOR_WEEK,
        alias="comparisonType",
    ),
):
    data = service.get_conversion_funnel(
        week=week,
        lob=lob,
        platform=platform,
        comparison_type=comparison_type.value,
    )

    return build_response(
        "overviewConversionFunnel",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "comparisonType": comparison_type,
        },
        data,
    )

