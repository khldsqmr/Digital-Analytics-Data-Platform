        comparison_type=comparison_type.value,
        display_size=display_size.value,
        metric=metric,
        pair_key=pair_key,
    )

    return build_response(
        "crosstabsMatrix",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "comparisonType": comparison_type,
            "displaySize": display_size,
            "metric": metric,
            "pairKey": pair_key,
        },
        data,
    )


@router.get(
    "/ranked-pairs",
    response_model=SectionResponse,
)
def ranked_pairs(
    week: date,
    lob: str = "All",
    platform: str = "All",

    comparison_type: ComparisonType = Query(
        ComparisonType.PRIOR_WEEK,
        alias="comparisonType",
    ),

    display_size: DisplaySize = Query(
        DisplaySize.TOP_10,
        alias="displaySize",
    ),

    metric: str | None = None,

    pair_key: str | None = Query(
        default=None,
        alias="pairKey",
    ),
):
    data = service.get_ranked_pairs(
        week=week,
        lob=lob,
        platform=platform,
        comparison_type=comparison_type.value,
        display_size=display_size.value,
        metric=metric,
        pair_key=pair_key,
    )

    return build_response(
        "crosstabsRankedPairs",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "comparisonType": comparison_type,
            "displaySize": display_size,
            "metric": metric,
            "pairKey": pair_key,
        },
        data,
    )

backend/app/routes/explore.py
from datetime import date

from fastapi import APIRouter, Query

from app.schemas.common import (
    ComparisonType,
    DisplaySize,
    SectionResponse,
)
from app.schemas.explore import (
    ExploreDimension,
    ExploreMetric,
)
from app.services import explore as service


router = APIRouter(
    prefix="/explore",
    tags=["Explore"],
)


def build_response(
    section: str,
    filters: dict,
    data: list[dict],
):
    return SectionResponse(
        section=section,
        filters=filters,
        rowCount=len(data),
        data=data,
    )


@router.get(
    "/results",
    response_model=SectionResponse,
)
def results(
    week: date,
    lob: str = "All",
    platform: str = "All",

    dimension: ExploreDimension = (
        ExploreDimension.PAGE_CATEGORY
    ),

    metric: ExploreMetric = (
        ExploreMetric.ORDERS
    ),

    channel: str | None = None,
    device: str | None = None,

    page_category: str | None = Query(
        default=None,
        alias="pageCategory",
    ),
):
    data = service.get_results(
        week=week,
        lob=lob,
        platform=platform,
        dimension=dimension.value,
        metric=metric.value,
        channel=channel,
        device=device,
        page_category=page_category,
    )

    return build_response(
        "exploreResults",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "dimension": dimension,
            "metric": metric,
            "channel": channel,
            "device": device,
            "pageCategory": page_category,
        },
        data,
    )


@router.get(
    "/ranked-pairs",
    response_model=SectionResponse,
)
def ranked_pairs(
    week: date,
    lob: str = "All",
    platform: str = "All",

    comparison_type: ComparisonType = Query(
        ComparisonType.PRIOR_WEEK,
        alias="comparisonType",
    ),

    display_size: DisplaySize = Query(
        DisplaySize.TOP_10,
        alias="displaySize",
    ),

    metric: str | None = None,

    pair_key: str | None = Query(
        default=None,
        alias="pairKey",
    ),
):
    data = service.get_ranked_pairs(
        week=week,
        lob=lob,
        platform=platform,
        comparison_type=comparison_type.value,
        display_size=display_size.value,
        metric=metric,
        pair_key=pair_key,
    )

    return build_response(
        "exploreRankedPairs",
        {
            "week": week,
            "lob": lob,
            "platform": platform,
            "comparisonType": comparison_type,
            "displaySize": display_size,
            "metric": metric,
            "pairKey": pair_key,
        },
        data,
    )

