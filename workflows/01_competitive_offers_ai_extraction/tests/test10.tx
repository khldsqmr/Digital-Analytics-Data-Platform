from datetime import date

from fastapi import APIRouter, Query

from app.schemas.common import (
    ComparisonType,
    DisplaySize,
    SectionResponse,
)
from app.services import breakouts as service


router = APIRouter(
    prefix="/breakouts",
    tags=["Breakouts"],
)


def build_response(
    section: str,
    filters: dict,
    data: list[dict],
):
    return SectionResponse(
        section=section,
        filters=filters,
        rowCount=len(data),
        data=data,
    )


def get_filters(
    week: date,
    lob: str,
    platform: str,
    comparison_type: ComparisonType,
    display_size: DisplaySize,
    metric: str | None,
    breakout_type: str | None,
):
    return {
        "week": week,
        "lob": lob,
        "platform": platform,
        "comparisonType": comparison_type,
        "displaySize": display_size,
        "metric": metric,
        "breakoutType": breakout_type,
    }


@router.get(
    "/comparison",
    response_model=SectionResponse,
)
def comparison(
    week: date,
    lob: str = "All",
    platform: str = "All",

    comparison_type: ComparisonType = Query(
        ComparisonType.PRIOR_WEEK,
        alias="comparisonType",
    ),

    display_size: DisplaySize = Query(
        DisplaySize.TOP_10,
        alias="displaySize",
    ),

    metric: str | None = None,

    breakout_type: str | None = Query(
        default=None,
        alias="breakoutType",
    ),
):
    data = service.get_comparison(
        week,
        lob,
        platform,
        comparison_type.value,
        display_size.value,
        metric,
        breakout_type,
    )

    return build_response(
        "breakoutsComparison",
        get_filters(
            week,
            lob,
            platform,
