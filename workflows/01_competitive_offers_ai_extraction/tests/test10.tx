-- ============================================================
-- TEST J:
-- Inspect purchase events that did NOT sessionize
-- ============================================================

WITH sef AS (
    SELECT
        row_identity_hash,
        event_date,
        source_table
    FROM prd_dbi_analytics.silver_digital_interactions.session_event_fact
    WHERE event_date = DATE '2026-09-27'
)

SELECT
    udi.row_identity_hash,
    udi.event_timestamp_utc,

    udi.source_table,
    udi.page_app_type,
    udi.site_name,

    udi.full_page_name,
    udi.page_name,
    udi.site_sub_section,
    udi.flow_name,

    udi.customer_type,
    udi.user_auth_state,

    udi.customer_id,
    udi.profile_uid,
    udi.first_party_id,
    udi.app_instance_id,
    udi.app_session_id,

    udi.event_page_view,
    udi.event_purchase

FROM prd_dbi_analytics.silver_digital_interactions.unified_digital_interactions udi

LEFT ANTI JOIN sef
    ON  udi.row_identity_hash = sef.row_identity_hash
    AND udi.event_date        = sef.event_date
    AND udi.source_table      = sef.source_table

WHERE udi.event_date = DATE '2026-09-27'
  AND COALESCE(udi.event_purchase, 0) = 1

ORDER BY
    udi.source_table,
    udi.page_app_type,
    udi.site_name,
    udi.event_timestamp_utc

LIMIT 500;
